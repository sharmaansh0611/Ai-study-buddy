<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AIStudyBuddy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorSurfaceContainerLow">@color/brand_surface</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/brand_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialCardViewStyle">@style/Widget.AIStudyBuddy.CardView</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AIStudyBuddy.Medium</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.AIStudyBuddy" parent="Base.Theme.AIStudyBuddy" />

    <!-- Elevated card: subtle shadow + hairline border -->
    <style name="Widget.AIStudyBuddy.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="strokeColor">@color/brand_outline</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/brand_card</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- 20dp rounded corners for all medium components -->
    <style name="ShapeAppearance.AIStudyBuddy.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Dashboard card item -->
    <style name="Widget.AIStudyBuddy.DashboardCard" parent="Widget.AIStudyBuddy.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <!-- Section heading text (explicit parent avoids AAPT dot-notation inference) -->
    <style name="TextAppearance.AIStudyBuddy.SectionLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
