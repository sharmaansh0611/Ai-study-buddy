<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:ignore="HardcodedText"
    app:cardCornerRadius="12dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/brand_card">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/btnCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="180dp"
            android:text="Copy"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_primary"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="8dp"
            android:background="#DBDBDB" />

        <TextView
            android:id="@+id/btnAskAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="180dp"
            android:text="Ask AI"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_primary"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="8dp"
            android:background="#DBDBDB" />

        <TextView
            android:id="@+id/btnMakeNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="180dp"
            android:text="Make Notes"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_primary"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="8dp"
            android:background="#DBDBDB" />

        <TextView
            android:id="@+id/btnMakeQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="180dp"
            android:text="Make Quiz"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_primary"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="8dp"
            android:background="#DBDBDB" />

        <TextView
            android:id="@+id/btnMakeFlashcard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="180dp"
            android:text="Make Flashcard"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_primary"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
