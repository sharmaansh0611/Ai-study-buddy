<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 🌊 Wave -->
        <ImageView
            android:id="@+id/wave"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:scaleType="fitXY"
            android:src="@drawable/wave"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cns2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/wave"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


        <!-- Title -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign up"
            android:textSize="28sp"
            android:fontFamily="@font/rubikvariablefontwght"
            android:textStyle="bold"
            android:textColor="#444"
            app:layout_constraintTop_toTopOf="@id/cns2"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Underline -->
        <View
            android:layout_width="50dp"
            android:layout_height="3dp"
            android:background="#8387FF"
            app:layout_constraintTop_toBottomOf="@id/textTitle"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- EMAIL -->
            <TextView
                android:id="@+id/emailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="14sp"
                android:textColor="#6B7280"
                app:layout_constraintTop_toBottomOf="@id/textTitle"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="32dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/email"
            app:startIconTint="@color/input_icon_color"
            app:layout_constraintTop_toBottomOf="@id/emailLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="demo@email.com"
                android:textSize="16sp"
                android:textColor="#111827"
                android:background="@null"
                android:paddingVertical="5dp"
                android:inputType="textEmailAddress"/>
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:id="@+id/emailLine"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:background="@color/input_line_color"
            app:layout_constraintTop_toBottomOf="@id/emailLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- PHONE -->
            <TextView
                android:id="@+id/phoneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Phone"
                android:textSize="14sp"
                android:textColor="#6B7280"
                app:layout_constraintTop_toBottomOf="@id/emailLine"
                app:layout_constraintStart_toStartOf="parent" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/phoneLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/phone"
            app:startIconTint="@color/input_icon_color"
            app:layout_constraintTop_toBottomOf="@id/phoneLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="+00 000-0000-000"
                android:textSize="16sp"
                android:textColor="#111827"
                android:background="@null"
                android:paddingVertical="5dp"
                android:inputType="phone"/>
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:id="@+id/phoneLine"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:background="@color/input_line_color"
            app:layout_constraintTop_toBottomOf="@id/phoneLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- PASSWORD -->
            <TextView
                android:id="@+id/passwordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:textColor="#6B7280"
                app:layout_constraintTop_toBottomOf="@id/phoneLine"
                app:layout_constraintStart_toStartOf="parent"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/password"
            app:startIconTint="@color/input_icon_color"
            app:endIconMode="password_toggle"
            app:layout_constraintTop_toBottomOf="@id/passwordLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your password"
                android:textSize="16sp"
                android:textColor="#111827"
                android:background="@null"
                android:paddingVertical="5dp"
                android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:id="@+id/passwordLine"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:background="@color/input_line_color"
            app:layout_constraintTop_toBottomOf="@id/passwordLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CONFIRM PASSWORD -->
            <TextView
                android:id="@+id/cnfpassLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:textColor="#6B7280"
                app:layout_constraintTop_toBottomOf="@id/passwordLine"
                app:layout_constraintStart_toStartOf="parent"
             />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirmLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/password"
            app:startIconTint="@color/input_icon_color"
            app:endIconMode="password_toggle"
            app:layout_constraintTop_toBottomOf="@id/cnfpassLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm your password"
                android:textSize="16sp"
                android:textColor="#111827"
                android:background="@null"
                android:paddingVertical="5dp"
                android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:id="@+id/confirmLine"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:background="@color/input_line_color"
            app:layout_constraintTop_toBottomOf="@id/confirmLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BUTTON -->
<!--        <com.google.android.material.button.MaterialButton-->
<!--            android:id="@+id/buttonSignup"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="56dp"-->
<!--            android:text="Create Account"-->
<!--            android:textColor="#FFFFFF"-->
<!--            android:textStyle="bold"-->
<!--            android:backgroundTint="@color/rounded_button"-->
<!--            app:cornerRadius="30dp"-->
<!--            app:layout_constraintTop_toBottomOf="@id/confirmLine"-->
<!--            app:layout_constraintStart_toStartOf="parent"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            android:layout_marginTop="32dp"/>-->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSignup"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="Create Account"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="@color/rounded_button"
                app:cornerRadius="30dp"
                app:layout_constraintTop_toBottomOf="@id/confirmLine"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="32dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"/>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:visibility="gone"
                app:indicatorColor="@color/brand_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/buttonSignup"
                app:trackColor="#E5E7EB" />

        <!-- LOGIN -->
        <TextView
            android:id="@+id/textLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an Account? Login"
            android:textColor="#9CA3AF"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/buttonSignup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>

